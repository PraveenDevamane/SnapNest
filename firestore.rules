rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================== USERS ====================
    // Users can read any profile, but only write their own
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // ==================== EVENTS ====================
    // Event access rules
    match /events/{eventId} {
      // Allow read for:
      // 1. Members of the event
      // 2. Pending members
      // 3. Creator
      // 4. ANY authenticated user (needed for joining by code)
      allow read: if request.auth != null;
      
      // Anyone authenticated can create an event
      allow create: if request.auth != null;
      
      // Update allowed for:
      // 1. Creator (full control)
      // 2. Any authenticated user ONLY to add themselves to pendingMemberIds (join request)
      // 3. Members (for limited updates)
      allow update: if request.auth != null && (
        // Creator can do anything
        request.auth.uid == resource.data.creatorId ||
        // Members can update
        request.auth.uid in resource.data.memberIds ||
        // Anyone can add themselves to pending members (join request)
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingMemberIds']) &&
          request.auth.uid in request.resource.data.pendingMemberIds
        )
      );
      
      // Only creator can delete
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.creatorId;
    }
    
    // ==================== PHOTOS ====================
    // CRITICAL: All authenticated users can read photos
    // This allows event members to see photos from other members
    match /photos/{photoId} {
      // Allow read for all authenticated users
      // The app filters by eventId, so only relevant photos are fetched
      allow read: if request.auth != null;
      
      // Anyone authenticated can create photos
      allow create: if request.auth != null;
      
      // Only the photo owner can update or delete
      allow update, delete: if request.auth != null && 
        request.auth.uid == resource.data.ownerId;
    }
  }
}
